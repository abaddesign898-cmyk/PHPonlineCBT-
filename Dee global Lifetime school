<?php
session_start();
ini_set('display_errors',1);
error_reporting(E_ALL);

$dbfile = __DIR__ . '/school.db';
$init = !file_exists($dbfile);
$pdo = new PDO('sqlite:' . $dbfile);
$pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

// Initialize DB
if($init){
    $pdo->exec("
    CREATE TABLE settings (k TEXT PRIMARY KEY, v TEXT);
    CREATE TABLE classes (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT);
    CREATE TABLE exams (id INTEGER PRIMARY KEY AUTOINCREMENT, class_id INTEGER, type TEXT, text TEXT, option_a TEXT, option_b TEXT, option_c TEXT, option_d TEXT, correct_option TEXT, mark_value REAL);
    CREATE TABLE students (id INTEGER PRIMARY KEY AUTOINCREMENT, full_name TEXT, class_id INTEGER);
    CREATE TABLE student_answers (id INTEGER PRIMARY KEY AUTOINCREMENT, student_id INTEGER, exam_id INTEGER, selected_option TEXT, answer_text TEXT, mark_awarded REAL);
    CREATE TABLE midterm (id INTEGER PRIMARY KEY AUTOINCREMENT, student_id INTEGER, score REAL);
    ");
    $stmt = $pdo->prepare("INSERT INTO settings (k,v) VALUES (?,?)");
    $stmt->execute(['school_name','Dee Global Life Time College']);
    $classes = ['JSS1','JSS2','JSS3','SSS1','SSS2','SSS3'];
    $stmt = $pdo->prepare("INSERT INTO classes (name) VALUES (?)");
    foreach($classes as $c) $stmt->execute([$c]);
}

// Helpers
function h($s){return htmlspecialchars($s ?? '',ENT_QUOTES);}
function getSetting($k){global $pdo;$s=$pdo->prepare("SELECT v FROM settings WHERE k=?");$s->execute([$k]);return $s->fetchColumn();}
function nav(){echo "<nav style='padding:10px;background:#f4f4f4;margin-bottom:10px;'><a href='?'>Home</a> | <a href='?action=admin'>Admin</a></nav>";}

// Actions
$action = $_GET['action'] ?? 'home';

// Add question
if($action==='add_question' && $_SERVER['REQUEST_METHOD']==='POST'){
    $stmt=$pdo->prepare("INSERT INTO exams (class_id,type,text,option_a,option_b,option_c,option_d,correct_option,mark_value) VALUES (?,?,?,?,?,?,?,?,?)");
    $stmt->execute([$_POST['class_id'],$_POST['type'],$_POST['text'],$_POST['option_a'],$_POST['option_b'],$_POST['option_c'],$_POST['option_d'],$_POST['correct_option'],$_POST['mark_value']]);
    header("Location: ?action=admin"); exit;
}

// Start exam
if($action==='start_exam' && $_SERVER['REQUEST_METHOD']==='POST'){
    $full_name = trim($_POST['full_name']);
    $class_id = $_POST['class_id'];
    if(!$full_name){$_SESSION['error']="Full name required"; header("Location: ?"); exit;}
    $stmt = $pdo->prepare("INSERT INTO students (full_name,class_id) VALUES (?,?)");
    $stmt->execute([$full_name,$class_id]);
    $_SESSION['student_id'] = $pdo->lastInsertId();
    header("Location: ?action=take_exam"); exit;
}

// Submit exam
if($action==='submit_exam' && $_SERVER['REQUEST_METHOD']==='POST'){
    $student_id = $_SESSION['student_id'];
    foreach($_POST['exam_ids'] as $eid){
        $stmt = $pdo->prepare("INSERT INTO student_answers (student_id,exam_id,selected_option,answer_text,mark_awarded) VALUES (?,?,?,?,?)");
        $stmt->execute([
            $student_id,
            $eid,
            $_POST['answer_'.$eid] ?? null,
            $_POST['text_'.$eid] ?? null,
            null
        ]);
    }
    header("Location: ?action=admin_mark"); exit;
}

// Auto mark
if($action==='auto_mark'){
    foreach($pdo->query("SELECT sa.id, sa.selected_option, sa.answer_text, e.type, e.correct_option, e.mark_value FROM student_answers sa JOIN exams e ON e.id=sa.exam_id") as $row){
        $mark = 0;
        if($row['type']==='mcq'){
            if(strtoupper($row['selected_option'])===strtoupper($row['correct_option'])) $mark=$row['mark_value'];
        } else {
            $mark = $row['mark_value'];
        }
        $stmt = $pdo->prepare("UPDATE student_answers SET mark_awarded=? WHERE id=?");
        $stmt->execute([$mark,$row['id']]);
    }
    header("Location: ?action=admin_mark"); exit;
}

// Save midterm (capped at 40)
if($action==='save_midterm' && $_SERVER['REQUEST_METHOD']==='POST'){
    $midterm_score = min(max($_POST['score'],0),40); // cap 0-40
    $stmt = $pdo->prepare("INSERT INTO midterm (student_id,score) VALUES (?,?)");
    $stmt->execute([$_POST['student_id'],$midterm_score]);
    header("Location: ?action=admin_mark"); exit;
}

// Views
$school_name = getSetting('school_name');
