<h3>Admin — Add Question</h3>
<form method="post" action="?action=add_question">
<label>Class<select name="class_id"><?php foreach($pdo->query("SELECT * FROM classes") as $c) echo "<option value='{$c['id']}'>".h($c['name'])."</option>";?></select></label>
<label>Type<select name="type"><option value="mcq">MCQ</option><option value="theory">Theory</option></select></label>
