<label>Midterm Score (out of 40)<input name="score" type="number" max="40" min="0" required></label>
<button class="btn">Save Midterm</button>
</form>

<h3>Print Exam Reports</h3>
<?php foreach($pdo->query("SELECT * FROM students") as $s): 
$answers = $pdo->prepare("SELECT sa.*, e.text qtext, e.type, e.correct_option, e.mark_value FROM student_answers sa JOIN exams e ON e.id=sa.exam_id WHERE sa.student_id=?");
$answers->execute([$s['id']]); $ans=$answers->fetchAll(PDO::FETCH_ASSOC);
$mid = $pdo->prepare("SELECT score FROM midterm WHERE student_id=?"); $mid->execute([$s['id']]); $midscore = $mid->fetchColumn()?:0;

// Exam score out of 60
$total_exam=array_sum(array_column($ans,'mark_awarded')); // exam total
$midscore = min($midscore,40); // midterm capped at 40
$total = $total_exam + $midscore;
if($total > 100) $total = 100; // total capped at 100
?>
<div class="card printarea">
<h4><?=h($s['full_name'])?></h4>
<p><strong>Exam Score:</strong> <?=h($total_exam)?> / 60</p>
<p><strong>Midterm Score:</strong> <?=h($midscore)?> / 40</p>
<p><strong>Total Score:</strong> <?=h($total)?> / 100</p>

<table>
<tr><th>#</th><th>Question</th><th>Answer</th><th>Mark</th></tr>
<?php foreach($ans as $k=>$a): 
$symbol = ($a['type']==='mcq' && strtoupper($a['selected_option'])===strtoupper($a['correct_option'])) || $a['type']==='theory' ? '✅' : '❌';
?>
<tr>
<td><?=($k+1)?></td>
<td><?=h($a['qtext'])?></td>
<td><?=h($a['selected_option']?:$a['answer_text'])." $symbol"?></td>
<td><?=h($a['mark_awarded'])?></td>
</tr>
<?php endforeach; ?>
