<?php elseif($action==='take_exam'): 
$student_id = $_SESSION['student_id'];
$class_id = $pdo->prepare("SELECT class_id FROM students WHERE id=?");
$class_id->execute([$student_id]); $class_id = $class_id->fetchColumn();
$questions = $pdo->prepare("SELECT * FROM exams WHERE class_id=? ORDER BY RANDOM()");
$questions->execute([$class_id]); $qs=$questions->fetchAll(PDO::FETCH_ASSOC);

// Shuffle MCQ options per student
foreach($qs as &$q){
    if($q['type']==='mcq'){
        $opts=[]; foreach(['A','B','C','D'] as $o){ if($q['option_'.$o]) $opts[$o]=$q['option_'.$o]; }
        $keys = array_keys($opts); shuffle($keys);
        $shuffled=[]; foreach(['A','B','C','D'] as $new_key){
            $old_key = array_shift($keys);
            $shuffled[$new_key] = $opts[$old_key] ?? '';
            if($old_key == strtoupper($q['correct_option'])) $q['correct_option']=$new_key;
        }
        $q['option_A']=$shuffled['A'] ?? ''; $q['option_B']=$shuffled['B'] ?? '';
        $q['option_C']=$shuffled['C'] ?? ''; $q['option_D']=$shuffled['D'] ?? '';
    }
}
unset($q);
?>
<div class="card">
<h3>Exam Questions</h3>
<form method="post" action="?action=submit_exam">
<?php foreach($qs as $q): ?>
<div class="question" style="margin:5px 0;padding:5px;border:1px dashed #ccc;">
<strong><?=h($q['text'])?> (<?=h($q['mark_value'])?>)</strong><br>
<?php if($q['type']==='mcq'): ?>
<?php foreach(['A','B','C','D'] as $opt): if(!$q['option_'.$opt]) continue; ?>
<label class="radio-label" data-radio="answer_<?=$q['id']?>"><input type="radio" name="answer_<?=$q['id']?>" value="<?=$opt?>" onclick="highlightRadio('answer_<?=$q['id']?>')"> (<?=$opt?>) <?=h($q['option_'.$opt])?></label>
<?php endforeach; ?>
<?php else: ?>
<textarea name="text_<?=$q['id']?>" rows="4" placeholder="Type your answer here..."></textarea>
<?php endif; ?>
<input type="hidden" name="exam_ids[]" value="<?=$q['id']?>">
</div>
<?php endforeach; ?>
<button class="btn">Submit Answers</button>
</form>
</div>

<?php elseif($action==='admin'): ?>
