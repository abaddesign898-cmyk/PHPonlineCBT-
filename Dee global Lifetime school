<script>
function highlightRadio(name){
    const labels = document.querySelectorAll('[data-radio="'+name+'"]');
    labels.forEach(l=>l.classList.remove('radio-selected'));
    const checked = document.querySelector('input[name="'+name+'"]:checked');
    if(checked) checked.parentNode.classList.add('radio-selected');
}
